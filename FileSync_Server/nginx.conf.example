# ============================================================================
#  File Sync - Server  nginx 配置片段
# ----------------------------------------------------------------------------
#  把下面几行加到你站点的 server { ... } 块里，保存后重载 nginx。
#  宝塔：网站 → 设置 → 配置文件
# ============================================================================

# 允许上传较大的文件。
# 客户端默认按 2MB 原始字节分片上传（base64 后约 2.7MB），
# 被 413 拒绝时会自动降档重试；api.php 自身上限为 8MB。
# 这里调得越大，客户端可用的分片就越大、请求数越少。
client_max_body_size 8m;

# ---------------------------------------------------------------------------
# 缓存策略（两类文件分开处理）
#
# ！！重要：宝塔默认配置里有这两段，正则 location 是「按出现顺序，先匹配到的先生效」，
#    所以本文件里的规则必须放在宝塔那段【前面】，或者直接把宝塔那段删掉。
#
#       location ~ .*\.(js|css)?$ { expires 12h; ... }
#       location ~ .*\.(gif|jpg|jpeg|png|bmp|swf)$ { expires 30d; ... }
# ---------------------------------------------------------------------------

# ① 文本类：永不缓存（改完立刻生效）
location ~* \.(?:js|css|html?)$ {
    # no-store 才是真正的「不缓存」；no-cache 只是「每次都回源校验」。
    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    add_header Expires "Thu, 01 Jan 1970 00:00:00 GMT" always;
    etag off;                 # 断掉 ETag 这条 304 路径
    if_modified_since off;    # 断掉 Last-Modified 这条 304 路径
}

# ② 图片 / 音频 / 歌词：长期缓存
#    这些文件都在 MB 级，每次重下是灾难，必须让浏览器存住。
#    URL 上带的内容哈希 ?v= 负责失效：文件不改 → v 不变 → 一直用缓存；
#    文件一改 → v 自动变 → 立刻拉到新的（见 main.py 的 bump_asset_versions）。
#    lrc 只有几 KB，之所以也放这儿，是因为它的哈希会随内容变，缓存它零风险。
location ~* \.(?:png|jpe?g|gif|webp|avif|svg|ico|bmp|lrc|mp3|m4a|ogg|wav|flac|mp4|webm)$ {
    expires 30d;
    add_header Cache-Control "public, max-age=2592000" always;
    access_log off;
}

# ---------------------------------------------------------------------------
# gzip：只对「文本类」有意义
#
# ！！PNG / JPG / WebP / MP3 / MP4 本身已经是压缩格式，再 gzip 基本零收益
#   （实测 bg.png：17.10 MB -> gzip 17.10 MB，100.0%；bg.mp3 -> 99.3%），
#    收进来只是白耗 CPU，所以 gzip_types 里故意不列这些扩展名。
#    gzip 真正省流量的是 js/css/html/json —— 这些能压到原体积的 1/3 左右。
# ---------------------------------------------------------------------------
gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_comp_level 6;
gzip_types text/plain text/css text/xml text/javascript
           application/json application/javascript application/xml+rss
           application/manifest+json image/svg+xml;
# 注：text/html 默认就会被 gzip，不用列。
# 如果服务器装了 brotli 模块，再加下面两行，比 gzip 再小 15~20%：
#   brotli on;
#   brotli_types text/plain text/css text/xml text/javascript
#                application/json application/javascript application/xml+rss;

# 禁止访问归档 / 状态 / 仓库 / 回收站目录。
#   ignored/   同步时被"归档"掉的旧文件
#   .lgstate/  防重放 nonce 缓存
#   .lgrepo/   提交历史 + 全站文件内容快照（泄露 = 源码泄露，务必 deny）
#   .lgtrash/  在线编辑器删除的文件（回收站）
location ~ ^/(ignored|\.lgstate|\.lgrepo|\.lgtrash)/ {
    deny all;
}

# 双保险：禁止访问任何密钥文件。
# 即使密钥目录被误放进站点根，这一条也能兜住。
location ~ \.pem$ {
    deny all;
}

# 可选：在线编辑器的配置文件（若你建了 code/config.php 存密码，别让它被下载）
location = /code/config.php {
    deny all;
}

# 可选：避免 api.php 被搜索引擎收录
location = /api.php {
    add_header X-Robots-Tag "noindex, nofollow" always;
}
